<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>نظام تسجيل الدخول والموقع الجغرافي</title>
  <!-- مكتبة تسجيل الدخول من جوجل -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #0d0f18;
      color: #fff;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
    }
    .card {
      background: #141824;
      border: 1px solid #00f3ff33;
      border-radius: 16px;
      padding: 30px;
      width: 350px;
      text-align: center;
      box-shadow: 0 0 15px rgba(0, 243, 255, 0.1);
    }
    h2 {
      color: #00f3ff;
      margin-bottom: 20px;
    }
    .btn {
      background: #00f3ff;
      color: #000;
      border: none;
      padding: 10px 20px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 15px;
      width: 100%;
    }
    .status {
      margin-top: 15px;
      font-size: 14px;
      color: #a0aab8;
    }
  </style>
</head>
<body>

  <div class="card">
    <h2>تسجيل الدخول الآمن</h2>
    
    <!-- زر تسجيل الدخول بواسطة جوجل -->
    <div id="g_id_onload"
         data-client_id="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
         data-callback="handleCredentialResponse">
    </div>
    <div class="g_id_signin" data-type="standard"></div>

    <hr style="border-color: #00f3ff22; margin: 20px 0;">

    <!-- تحديد الموقع الجغرافي -->
    <h3>موقعك الجغرافي</h3>
    <button class="btn" onclick="getLocation()">مشاركة الموقع الحالي</button>
    <div class="status" id="location-status">لم يتم تحديد الموقع بعد.</div>
  </div>

  <script>
    // معالجة الاستجابة بعد تسجيل الدخول بواسطة جوجل
    function handleCredentialResponse(response) {
      console.log("Encoded JWT ID token: " + response.credential);
      alert("تم تسجيل الدخول بنجاح عبر حساب جوجل!");
    }

    // الحصول على الموقع الجغرافي باستخدام HTML5 Geolocation API
    function getLocation() {
      const status = document.getElementById("location-status");

      if (navigator.geolocation) {
        status.innerText = "جاري طلب إذن الوصول للموقع...";
        navigator.geolocation.getCurrentPosition(
          (position) => {
            const lat = position.coords.latitude;
            const lon = position.coords.longitude;
            status.innerText = `خط العرض: ${lat}\nخط الطول: ${lon}`;
          },
          (error) => {
            switch(error.code) {
              case error.PERMISSION_DENIED:
                status.innerText = "تم رفض طلب الوصول للموقع من قبل المستخدم.";
                break;
              case error.POSITION_UNAVAILABLE:
                status.innerText = "معلومات الموقع غير متوفرة.";
                break;
              case error.TIMEOUT:
                status.innerText = "انتهت مهلة طلب الموقع.";
                break;
              default:
                status.innerText = "حدث خطأ غير معروف.";
                break;
            }
          }
        );
      } else {
        status.innerText = "المتصفح لديك لا يدعم ميزة تحديد الموقع الجغرافي.";
      }
    }
  </script>

</body>
</html>
